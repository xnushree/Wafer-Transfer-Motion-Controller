<?xml version="1.0"?>
<!--
  Simplified R-theta-Z wafer-transfer robot for visualisation.
  Inspired by the class of cylindrical semiconductor wafer handlers; the
  geometry is illustrative and does not represent any commercial robot.

  Kinematic chain (joint values match the simulation, SI units):
    base_link -theta_joint (revolute, z)-> turret_link
              -z_joint (prismatic, z)-> carriage_link
              -r_joint (prismatic, x)-> fork_link

  fork_link's origin is the arm tip (the wafer centre when carried), so in
  base_link it sits at (r cos(theta), r sin(theta), z), the same point as
  forward_kinematics(). Only visuals changed when the model was restyled.
-->
<robot name="wafer_transfer_robot">

  <material name="graphite"><color rgba="0.16 0.17 0.19 1.0"/></material>
  <material name="housing"><color rgba="0.80 0.82 0.85 1.0"/></material>
  <material name="aluminium"><color rgba="0.62 0.65 0.69 1.0"/></material>
  <material name="ceramic"><color rgba="0.95 0.95 0.93 1.0"/></material>
  <material name="accent"><color rgba="0.10 0.42 0.78 1.0"/></material>
  <material name="rubber"><color rgba="0.08 0.08 0.09 1.0"/></material>

  <!-- ===== Fixed base ===== -->
  <link name="base_link">
    <visual>
      <!-- Floor plate -->
      <origin xyz="0 0 0.006"/>
      <geometry><cylinder radius="0.115" length="0.012"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <!-- Drive housing -->
      <origin xyz="0 0 0.029"/>
      <geometry><cylinder radius="0.088" length="0.034"/></geometry>
      <material name="housing"/>
    </visual>
    <visual>
      <!-- Accent ring under the turntable -->
      <origin xyz="0 0 0.048"/>
      <geometry><cylinder radius="0.090" length="0.004"/></geometry>
      <material name="accent"/>
    </visual>
  </link>

  <joint name="theta_joint" type="revolute">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="2.0"/>
  </joint>

  <!-- ===== Rotating turret with the Z column ===== -->
  <link name="turret_link">
    <visual>
      <!-- Turntable -->
      <origin xyz="0 0 0.006"/>
      <geometry><cylinder radius="0.078" length="0.012"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <!-- Column -->
      <origin xyz="-0.050 0 0.165"/>
      <geometry><box size="0.050 0.090 0.310"/></geometry>
      <material name="housing"/>
    </visual>
    <visual>
      <!-- Column cap -->
      <origin xyz="-0.050 0 0.325"/>
      <geometry><box size="0.058 0.098 0.012"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <!-- Linear guide rail on the column face -->
      <origin xyz="-0.023 0 0.165"/>
      <geometry><box size="0.004 0.030 0.290"/></geometry>
      <material name="graphite"/>
    </visual>
  </link>

  <joint name="z_joint" type="prismatic">
    <parent link="turret_link"/>
    <child link="carriage_link"/>
    <!-- -0.05 cancels the turret offset, so carriage height = z joint value -->
    <origin xyz="0 0 -0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.05" upper="0.30" effort="100" velocity="0.2"/>
  </joint>

  <!-- ===== Z carriage with the first arm stage ===== -->
  <link name="carriage_link">
    <visual>
      <!-- Carriage block riding on the rail -->
      <origin xyz="-0.012 0 -0.004"/>
      <geometry><box size="0.030 0.100 0.060"/></geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <!-- Fixed outer arm stage -->
      <origin xyz="0.045 0 -0.020"/>
      <geometry><box size="0.090 0.056 0.020"/></geometry>
      <material name="housing"/>
    </visual>
  </link>

  <joint name="r_joint" type="prismatic">
    <parent link="carriage_link"/>
    <child link="fork_link"/>
    <origin xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.05" upper="0.45" effort="100" velocity="0.5"/>
  </joint>

  <!-- ===== Sliding inner arm stage and wafer fork ===== -->
  <link name="fork_link">
    <visual>
      <!-- Inner arm stage, slides out of the outer stage -->
      <origin xyz="-0.115 0 -0.012"/>
      <geometry><box size="0.150 0.040 0.012"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <!-- Wrist block -->
      <origin xyz="-0.042 0 -0.006"/>
      <geometry><box size="0.024 0.074 0.012"/></geometry>
      <material name="graphite"/>
    </visual>
    <visual>
      <!-- Fork prong (left) -->
      <origin xyz="0.020 0.024 -0.0015"/>
      <geometry><box size="0.100 0.014 0.003"/></geometry>
      <material name="ceramic"/>
    </visual>
    <visual>
      <!-- Fork prong (right) -->
      <origin xyz="0.020 -0.024 -0.0015"/>
      <geometry><box size="0.100 0.014 0.003"/></geometry>
      <material name="ceramic"/>
    </visual>
    <visual>
      <!-- Vacuum pad (left tip) -->
      <origin xyz="0.058 0.024 0.0005"/>
      <geometry><cylinder radius="0.005" length="0.001"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <!-- Vacuum pad (right tip) -->
      <origin xyz="0.058 -0.024 0.0005"/>
      <geometry><cylinder radius="0.005" length="0.001"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <!-- Vacuum pad (rear) -->
      <origin xyz="-0.022 0 0.0005"/>
      <geometry><cylinder radius="0.005" length="0.001"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>

</robot>
