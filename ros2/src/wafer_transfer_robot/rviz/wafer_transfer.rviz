Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Floor grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 24
      Color: 110; 115; 125
      Alpha: 0.35
      Line Style:
        Line Width: 0.03
        Value: Lines
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Stations and wafer
      Enabled: true
      Topic:
        Value: /robot/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Forbidden zones
      Enabled: true
      Topic:
        Value: /robot/safety_markers
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Arm tip path
      Enabled: true
      Topic:
        Value: /robot/ee_path
      Color: 64; 200; 255
      Alpha: 0.8
      Line Style: Billboards
      Line Width: 0.003
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 32; 35; 42
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.25
      Focal Point:
        X: 0.12
        Y: 0.14
        Z: 0.10
      Pitch: 0.80
      Yaw: 5.95
      Field of View: 0.75
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Height: 800
  Width: 1200
